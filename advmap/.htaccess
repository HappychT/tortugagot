# ════════════════════════════════════════════════
#  Tortuga Map — .htaccess (Apache)
#  Production security config
# ════════════════════════════════════════════════

# ──────────────────────────────────────────────
#  1. ADMIN PANEL — Basic Auth (серверная защита)
#     Создай .htpasswd файл командой:
#     htpasswd -c /путь/к/.htpasswd имяПользователя
#     Или онлайн: https://www.web2generators.com/apache-tools/htpasswd-generator
#     Положи .htpasswd НА УРОВЕНЬ ВЫШЕ advmap/ (вне веб-корня)
# ──────────────────────────────────────────────
<Files "admin.html">
    AuthType Basic
    AuthName "Tortuga Admin"
    AuthUserFile /var/www/.htpasswd
    Require valid-user
</Files>

# Блокируем прямой доступ к admin_config.js из браузера
# (теперь он нужен только для хранения pwHash — токен убран)
<Files "admin_config.js">
    Order Allow,Deny
    Deny from all
</Files>

# Блокируем листинг директорий
Options -Indexes

# Запрещаем доступ к служебным файлам
<FilesMatch "\.(py|json|md|log|sh|htpasswd)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ──────────────────────────────────────────────
#  2. Security Headers
# ──────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://unpkg.com https://cdnjs.cloudflare.com; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com;"
    # Скрываем версию Apache
    Header unset Server
    Header always unset X-Powered-By
</IfModule>

# ──────────────────────────────────────────────
#  3. Производительность
# ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>
